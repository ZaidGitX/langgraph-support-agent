# Placeholders for langgraph_support_app. Copy to .env and fill in locally; set the same
# NAMES as GitHub secrets or CI variables for hosted runs. Never commit a value. Generated
# from orchestrator/credentials.json by orchestrator.credentials.render_env_example().

# Astra and Jev
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
LANGSMITH_API_KEY=

# GitHub Actions dispatch
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_REPOSITORY=
GITHUB_REF=
GITHUB_REF_NAME=
GITHUB_SHA=
GITHUB_PERSONAL_ACCESS_TOKEN=

# AWS (CodeBuild, ECR, ECS, S3, CloudFormation, CloudWatch)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_REGION=
AWS_ACCOUNT_ID=
AWS_CODEBUILD_PROJECT=
AWS_ECR_REPOSITORY=
AWS_ECS_CLUSTER=
AWS_ECS_SERVICE=
AWS_S3_BUCKET=
AWS_CFN_STACK=

# Google Cloud (Cloud Build, Artifact Registry, Cloud Run, GCS)
GOOGLE_APPLICATION_CREDENTIALS=
GCLOUD_SA_KEY=
GCP_PROJECT_ID=
GCP_REGION=
GCP_ARTIFACT_REPO=
GCP_CLOUD_RUN_SERVICE=
GCS_BUCKET=

# Azure (Pipelines, ACR, Container Apps)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
AZURE_ACR_NAME=
AZURE_CONTAINER_APP=
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_EXT_PAT=
AZURE_PIPELINE_ID=

# Jenkins (REST API)
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_JOB=

# Docker and registries
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
REGISTRY_URL=
GHCR_TOKEN=
ORCHESTRATOR_DOCKER_IMAGE=python:3.12-slim

# Remote host over SSH
SSH_HOST=
SSH_USER=
SSH_KEY_PATH=
SSH_PORT=22

# Kubernetes
KUBECONFIG=
K8S_NAMESPACE=
K8S_CONTEXT=

# Scanner services
SONAR_TOKEN=
SONAR_ORGANIZATION=
SONAR_PROJECT_KEY=
SNYK_TOKEN=
HAWK_API_KEY=
HAWK_APP_ID=
SEMGREP_APP_TOKEN=
TRIVY_TOKEN=
GITLEAKS_LICENSE=
NVD_API_KEY=

# Artifact signing
COSIGN_KEY=
COSIGN_PASSWORD=

# Orchestrator toggles
ORCHESTRATOR_DISPATCH=local
ORCHESTRATOR_AUTOSTART=1
ORCHESTRATOR_DB=var/orchestrator.sqlite
ORCHESTRATOR_CLOUD_APPLY=0
ORCHESTRATOR_WRITE_ARTIFACTS=0
ORCHESTRATOR_EMBEDDINGS=bm25
ORCHESTRATOR_MCP=0
ORCHESTRATOR_ASTRA_TEMPERATURE=0.7
APP_PUBLIC_URL=
