# Generated by the orchestrator: the whole pipeline for Google Cloud Build ($APP_NAME) on $GENERATED_AT.
# gcloud builds submit --config ci/cloudbuild.yaml --substitutions _RUN_ID=<run>,_TIER=<tier>,_STAGE=<name>
# An empty _STAGE runs every step in order; a named stage runs that step only.
# Production is not a choice; UAT stays with the orchestrator's human gate.
substitutions:
  _RUN_ID: "$RUN_ID"
  _TIER: "$TIER"
  _STAGE: ""
  _APP_NAME: "$APP_NAME"
options:
  logging: CLOUD_LOGGING_ONLY
  substitutionOption: ALLOW_LOOSE
timeout: 3600s
steps:
  - id: refuse-production
    name: gcr.io/cloud-builders/gcloud
    entrypoint: bash
    args: ["-c", 'case "$$_TIER" in production|prod) echo "No path past UAT."; exit 2;; esac']
$STAGE_BLOCKS
