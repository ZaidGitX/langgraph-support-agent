# Passed with --buildspec-override from the orchestrator's CodeBuild project. Credentials come
# from the service role or from Secrets Manager references by NAME; never from literals.
version: 0.2

env:
  variables:
    RUN_ID: "$RUN_ID"
    TIER: "$TIER"
    STAGE: "$STAGE"
    PLATFORM: "aws"
    APP_NAME: "$APP_NAME"
$SECRETS_MANAGER_LINES

cache:
  paths:
    - "/root/.cache/pip/**/*"
    - "frontend/node_modules/**/*"

phases:
  install:
    runtime-versions:
      python: $PYTHON_VERSION
      nodejs: $NODE_VERSION
    commands:
      - case "$$TIER" in production|prod) echo "No path past UAT."; exit 2;; esac
  build:
    commands:
      # --- ASTRA: $STAGE steps --- translate .github/workflows/$WORKFLOW_FILE for CodeBuild.
$STAGE_COMMANDS
  post_build:
    commands:
      - echo "stage $STAGE finished for run $$RUN_ID"

# No artifacts block: the project has no artifacts destination (NO_ARTIFACTS); an artifacts
# section fails the build at UPLOAD_ARTIFACTS after every phase passed (live run 8).
