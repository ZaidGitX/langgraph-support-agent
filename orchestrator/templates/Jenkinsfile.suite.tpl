// Generated by the orchestrator: the whole pipeline for Jenkins ($APP_NAME) on $GENERATED_AT.
// The orchestrator triggers one stage at a time through buildWithParameters with STAGE=<name>;
// an empty STAGE runs every stage in order. Production is not a choice; UAT stays with the
// orchestrator's human gate.
pipeline {
  agent any
  options { timeout(time: 60, unit: 'MINUTES') }
  parameters {
    string(name: 'RUN_ID', defaultValue: '', description: 'Orchestrator run id')
    string(name: 'TIER', defaultValue: '$TIER', description: 'local, dev, staging, or uat. Production is not a choice.')
    string(name: 'STAGE', defaultValue: '', description: 'One stage, or empty for all: $STAGE_NAMES')
  }
  environment {
    APP_NAME = '$APP_NAME'
    PLATFORM = 'jenkins'
$ENV_LINES
  }
  stages {
    stage('Refuse production') {
      steps {
        sh 'case "$$TIER" in production|prod) echo "No path past UAT."; exit 2;; esac'
      }
    }
$STAGE_BLOCKS
  }
  post {
    always { echo "pipeline finished for run $${params.RUN_ID} stage $${params.STAGE}" }
  }
}
