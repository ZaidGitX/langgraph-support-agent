# Generated by the orchestrator for stage "$STAGE" (family $FAMILY) on $GENERATED_AT.
# Dispatch only. A push never starts this workflow. There is no production job; the
# pipeline stops at UAT. Secrets are referenced by name only.
name: gen-$STAGE

on:
  workflow_dispatch:
    inputs:
      run_id:
        description: Orchestrator run id
        required: true
        type: string
      tier:
        description: Target tier (local, dev, staging, uat). Production is not a choice.
        required: false
        default: "$TIER"
        type: string

permissions:
  contents: read

env:
  RUN_ID: $${{ inputs.run_id }}
  TIER: $${{ inputs.tier }}
  PLATFORM: "$PLATFORM"
  APP_NAME: "$APP_NAME"
$SECRETS_LINES

jobs:
  $STAGE:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "$PYTHON_VERSION"

      - name: Refuse production
        run: |
          case "$${TIER}" in
            production|prod) echo "No path past UAT."; exit 2 ;;
          esac

      # --- ASTRA: steps ---
