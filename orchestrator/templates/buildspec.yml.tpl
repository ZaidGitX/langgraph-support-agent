# Generated by the orchestrator for stage "$STAGE" (family $FAMILY) on $GENERATED_AT.
# AWS CodeBuild buildspec, passed with --buildspec-override. Credentials come from the
# CodeBuild service role or from the environment names below; never from literals.
version: 0.2

env:
  shell: bash
  variables:
    RUN_ID: "$RUN_ID"
    TIER: "$TIER"
    PLATFORM: "aws"
    APP_NAME: "$APP_NAME"
  # AWS_REGION, AWS_S3_BUCKET, APP_NAME, and TIER come from the CodeBuild project; never set
  # AWS_REGION here (an empty value overrides the project's and breaks every aws call).
  # secrets-manager or parameter-store references go here by NAME, for example:
  # secrets-manager:
  #   SNYK_TOKEN: "$APP_NAME/snyk:SNYK_TOKEN"

cache:
  paths:
    - "/root/.cache/pip/**/*"
    - "frontend/node_modules/**/*"

phases:
  install:
    runtime-versions:
      python: $PYTHON_VERSION
      nodejs: $NODE_VERSION
    commands:
      - case "$$TIER" in production|prod) echo "No path past UAT."; exit 2;; esac
      - pip install -r requirements-dev.txt
  build:
    commands:
      # --- ASTRA: steps ---
      # Write the commands for "$PURPOSE" here. Print a one-line summary at the end.
      - echo "stage $STAGE placeholder"

# No artifacts block: the orchestrator's project has no artifacts destination (NO_ARTIFACTS),
# and an artifacts section fails the build at UPLOAD_ARTIFACTS after every phase passed
# (live run 8). Evidence goes to CloudWatch Logs; a file a later stage needs goes to S3 by hand.
