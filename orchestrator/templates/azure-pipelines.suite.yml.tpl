# Generated by the orchestrator: the whole pipeline for Azure Pipelines ($APP_NAME) on $GENERATED_AT.
# az pipelines run --id <pipeline> --parameters runId=<run> tier=<tier> stage=<name>
# An empty stage parameter runs every stage in order. Production is not a choice; UAT stays
# with the orchestrator's human gate.
trigger: none
pr: none

parameters:
  - name: runId
    type: string
    default: ''
  - name: tier
    type: string
    default: '$TIER'
  - name: stage
    type: string
    default: ''

variables:
  APP_NAME: '$APP_NAME'
  PLATFORM: 'azure'

pool:
  vmImage: ubuntu-latest

stages:
  - stage: refuse_production
    jobs:
      - job: guard
        steps:
          - bash: |
              case "$${{ parameters.tier }}" in production|prod) echo "No path past UAT."; exit 2;; esac
            displayName: refuse production
$STAGE_BLOCKS
