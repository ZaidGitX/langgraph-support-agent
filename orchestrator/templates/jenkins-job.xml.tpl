<?xml version='1.1' encoding='UTF-8'?>
<!-- Generated by the orchestrator for $APP_NAME (run $RUN_ID): a Pipeline job that reads
     ci/pipeline.Jenkinsfile from the remote. Created through POST /createItem. -->
<flow-definition plugin="workflow-job">
  <description>Orchestrator pipeline for $APP_NAME. Parameters RUN_ID, TIER, STAGE. Production is not a choice.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition><name>RUN_ID</name><defaultValue></defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition><name>TIER</name><defaultValue>$TIER</defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition><name>STAGE</name><defaultValue></defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>$REPO_URL</url>
          <credentialsId>GIT_REMOTE_TOKEN</credentialsId>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec><name>*/$BRANCH</name></hudson.plugins.git.BranchSpec>
      </branches>
    </scm>
    <scriptPath>ci/pipeline.Jenkinsfile</scriptPath>
    <lightweight>true</lightweight>
  </definition>
  <disabled>false</disabled>
</flow-definition>
