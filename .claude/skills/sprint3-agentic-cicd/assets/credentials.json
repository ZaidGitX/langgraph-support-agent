{
  "version": 1,
  "note": "Names only. No value is ever stored here, in state, in logs, or in prompts. Copy to orchestrator/credentials.json and keep identical. kind: secret (redacted by value), config (not secret, never echoed), path (file path).",
  "groups": {
    "app": {
      "label": "Astra and Jev",
      "env": [
        {"name": "OPENAI_API_KEY", "kind": "secret", "required": true, "purpose": "Astra via the OpenAI Responses API", "github_secret": true},
        {"name": "OPENAI_MODEL", "kind": "config", "required": false, "default": "gpt-6-astra", "purpose": "Astra model name"},
        {"name": "TYPESAFE_API_KEY", "kind": "secret", "required": true, "purpose": "Jev via langchain_typesafe.TypeSafeClassifier", "github_secret": true},
        {"name": "TYPESAFE_MODEL", "kind": "config", "required": false, "default": "jev-latest", "purpose": "Jev model name"},
        {"name": "LANGSMITH_API_KEY", "kind": "secret", "required": false, "purpose": "optional LangSmith tracing", "github_secret": true}
      ]
    },
    "github": {
      "label": "GitHub Actions dispatch",
      "cli": "gh",
      "runners": ["github_actions"],
      "providers": ["github_actions", "github_release", "ghcr"],
      "env": [
        {"name": "GITHUB_TOKEN", "kind": "secret", "required": true, "purpose": "gh workflow run / gh run watch; provided by Actions", "github_secret": false},
        {"name": "GH_TOKEN", "kind": "secret", "required": false, "purpose": "alternative to GITHUB_TOKEN for the gh CLI"},
        {"name": "GITHUB_REPOSITORY", "kind": "config", "required": true, "purpose": "owner/name for --repo"},
        {"name": "GITHUB_REF", "kind": "config", "required": false, "purpose": "ref of the push"},
        {"name": "GITHUB_REF_NAME", "kind": "config", "required": false, "purpose": "branch name for --ref"},
        {"name": "GITHUB_SHA", "kind": "config", "required": false, "purpose": "commit to match dispatched runs"},
        {"name": "GITHUB_PERSONAL_ACCESS_TOKEN", "kind": "secret", "required": false, "purpose": "GitHub MCP server only"}
      ],
      "alternatives": [["GITHUB_TOKEN"], ["GH_TOKEN"]],
      "docs": "https://cli.github.com/manual/gh_workflow_run"
    },
    "aws": {
      "label": "AWS (CodeBuild, ECR, ECS, S3, CloudFormation, CloudWatch)",
      "cli": "aws",
      "runners": ["aws_codebuild"],
      "providers": ["aws_codebuild", "aws_ecs", "aws_cfn", "aws_s3", "ecr", "cloudwatch"],
      "env": [
        {"name": "AWS_ACCESS_KEY_ID", "kind": "secret", "required": true, "purpose": "CLI credentials", "github_secret": true},
        {"name": "AWS_SECRET_ACCESS_KEY", "kind": "secret", "required": true, "purpose": "CLI credentials", "github_secret": true},
        {"name": "AWS_SESSION_TOKEN", "kind": "secret", "required": false, "purpose": "temporary credentials", "github_secret": true},
        {"name": "AWS_PROFILE", "kind": "config", "required": false, "purpose": "named profile instead of key pair (local only)"},
        {"name": "AWS_REGION", "kind": "config", "required": true, "purpose": "region for every call"},
        {"name": "AWS_ACCOUNT_ID", "kind": "config", "required": false, "purpose": "ECR registry host"},
        {"name": "AWS_CODEBUILD_PROJECT", "kind": "config", "required": false, "purpose": "CodeBuild project for aws_codebuild runner"},
        {"name": "AWS_ECR_REPOSITORY", "kind": "config", "required": false, "purpose": "push_image target"},
        {"name": "AWS_ECS_CLUSTER", "kind": "config", "required": false, "purpose": "deploy_* on ECS"},
        {"name": "AWS_ECS_SERVICE", "kind": "config", "required": false, "purpose": "deploy_* on ECS"},
        {"name": "AWS_S3_BUCKET", "kind": "config", "required": false, "purpose": "publish_artifact"},
        {"name": "AWS_CFN_STACK", "kind": "config", "required": false, "purpose": "infra_plan / infra_apply"}
      ],
      "alternatives": [["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"], ["AWS_PROFILE"]],
      "docs": "https://docs.aws.amazon.com/cli/latest/reference/codebuild/start-build.html"
    },
    "gcp": {
      "label": "Google Cloud (Cloud Build, Artifact Registry, Cloud Run, GCS)",
      "cli": "gcloud",
      "runners": ["gcp_cloudbuild"],
      "providers": ["gcp_cloudbuild", "gcp_cloud_run", "artifact_registry", "gcs", "cloud_logging"],
      "env": [
        {"name": "GOOGLE_APPLICATION_CREDENTIALS", "kind": "path", "required": true, "purpose": "service-account JSON path", "github_secret": false},
        {"name": "GCLOUD_SA_KEY", "kind": "secret", "required": false, "purpose": "service-account JSON content (CI)", "github_secret": true},
        {"name": "GCP_PROJECT_ID", "kind": "config", "required": true, "purpose": "--project"},
        {"name": "GCP_REGION", "kind": "config", "required": false, "purpose": "Cloud Run / Artifact Registry region"},
        {"name": "GCP_ARTIFACT_REPO", "kind": "config", "required": false, "purpose": "push_image target"},
        {"name": "GCP_CLOUD_RUN_SERVICE", "kind": "config", "required": false, "purpose": "deploy_* on Cloud Run"},
        {"name": "GCS_BUCKET", "kind": "config", "required": false, "purpose": "publish_artifact"}
      ],
      "alternatives": [["GOOGLE_APPLICATION_CREDENTIALS"], ["GCLOUD_SA_KEY"]],
      "docs": "https://cloud.google.com/sdk/gcloud/reference/builds/submit"
    },
    "azure": {
      "label": "Azure (Pipelines, ACR, Container Apps)",
      "cli": "az",
      "runners": ["azure_pipelines"],
      "providers": ["azure_pipelines", "azure_container_apps", "acr", "azure_blob", "azure_monitor"],
      "env": [
        {"name": "AZURE_CLIENT_ID", "kind": "config", "required": true, "purpose": "service principal"},
        {"name": "AZURE_TENANT_ID", "kind": "config", "required": true, "purpose": "service principal"},
        {"name": "AZURE_CLIENT_SECRET", "kind": "secret", "required": true, "purpose": "service principal", "github_secret": true},
        {"name": "AZURE_SUBSCRIPTION_ID", "kind": "config", "required": true, "purpose": "subscription"},
        {"name": "AZURE_RESOURCE_GROUP", "kind": "config", "required": false, "purpose": "deploy_* target"},
        {"name": "AZURE_LOCATION", "kind": "config", "required": false, "purpose": "region"},
        {"name": "AZURE_ACR_NAME", "kind": "config", "required": false, "purpose": "push_image target"},
        {"name": "AZURE_CONTAINER_APP", "kind": "config", "required": false, "purpose": "deploy_* on Container Apps"},
        {"name": "AZURE_DEVOPS_ORG_URL", "kind": "config", "required": false, "purpose": "azure_pipelines runner"},
        {"name": "AZURE_DEVOPS_PROJECT", "kind": "config", "required": false, "purpose": "azure_pipelines runner"},
        {"name": "AZURE_DEVOPS_EXT_PAT", "kind": "secret", "required": false, "purpose": "az pipelines auth", "github_secret": true},
        {"name": "AZURE_PIPELINE_ID", "kind": "config", "required": false, "purpose": "az pipelines run --id"}
      ],
      "docs": "https://learn.microsoft.com/cli/azure/pipelines"
    },
    "jenkins": {
      "label": "Jenkins (REST API)",
      "runners": ["jenkins"],
      "providers": ["jenkins"],
      "env": [
        {"name": "JENKINS_URL", "kind": "config", "required": true, "purpose": "base URL, e.g. http://127.0.0.1:8080"},
        {"name": "JENKINS_USER", "kind": "config", "required": true, "purpose": "basic auth user"},
        {"name": "JENKINS_API_TOKEN", "kind": "secret", "required": true, "purpose": "basic auth token", "github_secret": true},
        {"name": "JENKINS_JOB", "kind": "config", "required": true, "purpose": "job to build with parameters"}
      ],
      "docs": "https://www.jenkins.io/doc/book/using/remote-access-api/"
    },
    "docker": {
      "label": "Docker and registries",
      "cli": "docker",
      "runners": ["docker"],
      "providers": ["docker", "dockerhub", "ghcr"],
      "env": [
        {"name": "DOCKERHUB_USERNAME", "kind": "config", "required": false, "purpose": "push_image to Docker Hub"},
        {"name": "DOCKERHUB_TOKEN", "kind": "secret", "required": false, "purpose": "push_image to Docker Hub", "github_secret": true},
        {"name": "REGISTRY_URL", "kind": "config", "required": false, "purpose": "generic registry host"},
        {"name": "GHCR_TOKEN", "kind": "secret", "required": false, "purpose": "push_image to GHCR (GITHUB_TOKEN also works)", "github_secret": true},
        {"name": "ORCHESTRATOR_DOCKER_IMAGE", "kind": "config", "required": false, "default": "python:3.12-slim", "purpose": "image for the docker runner"}
      ]
    },
    "ssh": {
      "label": "Remote host over SSH",
      "cli": "ssh",
      "runners": ["ssh_remote"],
      "providers": ["ssh_remote", "ssh_compose"],
      "env": [
        {"name": "SSH_HOST", "kind": "config", "required": true, "purpose": "remote host"},
        {"name": "SSH_USER", "kind": "config", "required": true, "purpose": "remote user"},
        {"name": "SSH_KEY_PATH", "kind": "path", "required": true, "purpose": "private key path (never the key content)"},
        {"name": "SSH_PORT", "kind": "config", "required": false, "default": "22", "purpose": "port"}
      ]
    },
    "kubernetes": {
      "label": "Kubernetes",
      "cli": "kubectl",
      "runners": ["kubernetes"],
      "providers": ["kubectl"],
      "env": [
        {"name": "KUBECONFIG", "kind": "path", "required": true, "purpose": "kubeconfig path; ~/.kube/config also counts"},
        {"name": "K8S_NAMESPACE", "kind": "config", "required": true, "purpose": "namespace for apply"},
        {"name": "K8S_CONTEXT", "kind": "config", "required": false, "purpose": "--context"}
      ]
    },
    "scanners": {
      "label": "Scanner services",
      "providers": ["sonar", "snyk", "stackhawk", "semgrep", "trivy", "gitleaks", "grype"],
      "env": [
        {"name": "SONAR_TOKEN", "kind": "secret", "required": false, "purpose": "SonarQube Cloud", "github_secret": true},
        {"name": "SONAR_ORGANIZATION", "kind": "config", "required": false, "purpose": "SonarQube Cloud organization key", "github_secret": true},
        {"name": "SONAR_PROJECT_KEY", "kind": "config", "required": false, "purpose": "SonarQube Cloud project key", "github_secret": true},
        {"name": "SNYK_TOKEN", "kind": "secret", "required": false, "purpose": "Snyk Open Source", "github_secret": true},
        {"name": "HAWK_API_KEY", "kind": "secret", "required": false, "purpose": "StackHawk", "github_secret": true},
        {"name": "HAWK_APP_ID", "kind": "config", "required": false, "purpose": "StackHawk application UUID", "github_secret": true},
        {"name": "SEMGREP_APP_TOKEN", "kind": "secret", "required": false, "purpose": "Semgrep Cloud (optional)", "github_secret": true},
        {"name": "TRIVY_TOKEN", "kind": "secret", "required": false, "purpose": "Trivy server (optional)", "github_secret": true},
        {"name": "GITLEAKS_LICENSE", "kind": "secret", "required": false, "purpose": "Gitleaks org license (optional)", "github_secret": true},
        {"name": "NVD_API_KEY", "kind": "secret", "required": false, "purpose": "Grype NVD rate limit (optional)", "github_secret": true}
      ]
    },
    "signing": {
      "label": "Artifact signing",
      "providers": ["cosign"],
      "env": [
        {"name": "COSIGN_KEY", "kind": "secret", "required": false, "purpose": "cosign private key content", "github_secret": true},
        {"name": "COSIGN_PASSWORD", "kind": "secret", "required": false, "purpose": "cosign key password", "github_secret": true}
      ]
    },
    "orchestrator": {
      "label": "Orchestrator toggles",
      "env": [
        {"name": "ORCHESTRATOR_DISPATCH", "kind": "config", "required": false, "default": "local", "purpose": "local | github"},
        {"name": "ORCHESTRATOR_AUTOSTART", "kind": "config", "required": false, "default": "1", "purpose": "start a session at boot"},
        {"name": "ORCHESTRATOR_DB", "kind": "path", "required": false, "default": "var/orchestrator.sqlite", "purpose": "checkpointer + episodes"},
        {"name": "ORCHESTRATOR_CLOUD_APPLY", "kind": "config", "required": false, "default": "0", "purpose": "1 lets cloud runners apply; otherwise plan"},
        {"name": "ORCHESTRATOR_WRITE_ARTIFACTS", "kind": "config", "required": false, "default": "0", "purpose": "1 materializes generated files into the repo after approval"},
        {"name": "ORCHESTRATOR_EMBEDDINGS", "kind": "config", "required": false, "default": "bm25", "purpose": "bm25 | openai"},
        {"name": "ORCHESTRATOR_MCP", "kind": "config", "required": false, "default": "0", "purpose": "1 attaches MCP servers from mcp_servers.json for read-only discovery"},
        {"name": "ORCHESTRATOR_ASTRA_TEMPERATURE", "kind": "config", "required": false, "default": "0.7", "purpose": "sampling temperature for proposals and generation"},
        {"name": "APP_PUBLIC_URL", "kind": "config", "required": false, "purpose": "tunnel URL for DAST"}
      ]
    }
  }
}
