{
  "version": 1,
  "note": "Scanner and test-tool catalog. argv templates use $ROOT, $IMAGE, $APP_URL, $RUN_ID. Copy to orchestrator/scanners.json. extract.fail_when is 'count>0' or 'exit!=0'.",
  "tools": {
    "semgrep": {"family": "scan", "stages": ["sast", "scanners"], "cli": "semgrep", "docker_image": "semgrep/semgrep:latest", "install": "uvx --from semgrep semgrep --version  # or brew install semgrep",
      "argv": {"sast": ["semgrep", "scan", "--config", "p/python", "--config", "p/javascript", "--metrics=off", "--quiet", "$ROOT"]},
      "ci_action": "semgrep via python -m venv (see scanners.yml)", "env": ["SEMGREP_APP_TOKEN"],
      "extract": {"count_regex": "Findings:\\s*(\\d+)", "line_regex": "❯|\\.py$|Findings:|^Ran ", "fail_when": "count>0", "next_step_hit": "Change the code Semgrep named, then run the scan again.", "next_step_clean": "No code change is required for Semgrep."},
      "aliases": ["semgrep", "sast (semgrep)"]},
    "bandit": {"family": "scan", "stages": ["sast"], "cli": "bandit", "docker_image": "ghcr.io/pycqa/bandit/bandit:latest", "install": "uvx --from bandit bandit --version",
      "argv": {"sast": ["bandit", "-q", "-r", "app", "orchestrator", "mcp_server", "-f", "txt"]},
      "env": [], "extract": {"count_regex": "Total issues \\(by severity\\):[\\s\\S]*?High:\\s*(\\d+)", "line_regex": "Issue:|Severity:|Location:", "fail_when": "count>0", "next_step_hit": "Fix the high-severity Bandit issues listed.", "next_step_clean": "No high-severity Bandit issue."}, "aliases": ["bandit"]},
    "codeql": {"family": "scan", "stages": ["sast", "scanners"], "cli": null, "docker_image": null, "install": "GitHub-hosted only (github/codeql-action)",
      "argv": {}, "ci_action": "github/codeql-action/analyze@v4", "env": [],
      "extract": {"count_regex": "(\\d+)\\s+alerts?", "line_regex": "alert|uploaded|no results", "fail_when": "count>0", "next_step_hit": "Open the repository code scanning alerts and fix the CodeQL results.", "next_step_clean": "No code change is required when code scanning shows no alerts."},
      "aliases": ["codeql", "perform codeql analysis"]},
    "sonar": {"family": "scan", "stages": ["sast", "scanners"], "cli": "sonar-scanner", "docker_image": "sonarsource/sonar-scanner-cli:latest", "install": "brew install sonar-scanner",
      "argv": {"sast": ["sonar-scanner", "-Dsonar.organization=$SONAR_ORGANIZATION", "-Dsonar.projectKey=$SONAR_PROJECT_KEY", "-Dsonar.sources=app,mcp_server,orchestrator,frontend/src"]},
      "ci_action": "SonarSource/sonarqube-scan-action@v7", "env": ["SONAR_TOKEN", "SONAR_ORGANIZATION", "SONAR_PROJECT_KEY"],
      "extract": {"count_regex": "QUALITY GATE STATUS:\\s*(FAILED)", "line_regex": "ANALYSIS SUCCESSFUL|dashboard|QUALITY GATE", "fail_when": "count>0", "next_step_hit": "Open the SonarQube Cloud dashboard and fix the failed quality gate.", "next_step_clean": "Open the SonarQube Cloud dashboard after processing finishes."},
      "aliases": ["sonar", "sonarqube"]},
    "pip_audit": {"family": "scan", "stages": ["sca", "build"], "cli": "pip-audit", "docker_image": null, "install": "pip install pip-audit (already in requirements-dev.txt)",
      "argv": {"sca": ["pip-audit", "-r", "requirements.txt", "--format", "json", "-o", "var/audit.json"]},
      "env": [], "extract": {"count_regex": "Found (\\d+) known vulnerabilit", "line_regex": "Found|vulnerabilit|fix", "fail_when": "count>0", "next_step_hit": "Upgrade the package pip-audit listed (scripts/audit_gate.py fails only fixable findings).", "next_step_clean": "No fixable vulnerability reported by pip-audit."}, "aliases": ["pip-audit", "sca (pip-audit)"]},
    "npm_audit": {"family": "scan", "stages": ["sca"], "cli": "npm", "docker_image": "node:22-slim", "install": "bundled with npm",
      "argv": {"sca": ["npm", "audit", "--prefix", "frontend", "--audit-level=high"]},
      "env": [], "extract": {"count_regex": "(\\d+)\\s+(high|critical)", "line_regex": "vulnerabilit|high|critical|fix available", "fail_when": "count>0", "next_step_hit": "Run npm audit fix in frontend or upgrade the package named.", "next_step_clean": "No high or critical npm vulnerability."}, "aliases": ["npm audit"]},
    "osv_scanner": {"family": "scan", "stages": ["sca"], "cli": "osv-scanner", "docker_image": "ghcr.io/google/osv-scanner:latest", "install": "brew install osv-scanner",
      "argv": {"sca": ["osv-scanner", "--recursive", "$ROOT"]},
      "env": [], "extract": {"count_regex": "(\\d+)\\s+vulnerabilit", "line_regex": "\\||vulnerabilit", "fail_when": "exit!=0", "next_step_hit": "Upgrade the packages OSV-Scanner listed.", "next_step_clean": "No OSV vulnerability."}, "aliases": ["osv"]},
    "snyk": {"family": "scan", "stages": ["sca", "scanners"], "cli": "snyk", "docker_image": "snyk/snyk:python", "install": "npm i -g snyk",
      "argv": {"sca": ["snyk", "test", "--file=requirements.txt", "--command=python3", "--fail-on=upgradable"]},
      "ci_action": "snyk/actions/setup@v1.0.0", "env": ["SNYK_TOKEN"],
      "extract": {"count_regex": "found\\s+(\\d+)\\s+issue", "line_regex": "Tested|vulnerable|✗|upgrade|patch|Severity", "fail_when": "count>0", "next_step_hit": "Upgrade the package Snyk named, then run the scan again.", "next_step_clean": "No dependency change is required for this Snyk test."},
      "aliases": ["snyk", "snyk open source"]},
    "trivy": {"family": "scan", "stages": ["container_scan", "sca", "iac_scan", "scanners"], "cli": "trivy", "docker_image": "aquasec/trivy:0.58.0", "install": "brew install trivy",
      "argv": {"container_scan": ["trivy", "image", "--severity", "HIGH,CRITICAL", "--exit-code", "1", "$IMAGE"],
               "sca": ["trivy", "fs", "--scanners", "vuln", "--severity", "HIGH,CRITICAL", "--exit-code", "1", "$ROOT"],
               "iac_scan": ["trivy", "config", "--severity", "HIGH,CRITICAL", "--exit-code", "1", "$ROOT"]},
      "ci_action": "aquasecurity/trivy-action@v0.36.0", "env": ["TRIVY_TOKEN"],
      "extract": {"count_regex": "Total:\\s*(\\d+)", "line_regex": "^│|Total:|Report Summary|requirements.txt|package-lock.json", "fail_when": "count>0", "next_step_hit": "Upgrade the vulnerable package Trivy listed, then run the scan again.", "next_step_clean": "No dependency change is required for Trivy."},
      "aliases": ["trivy", "vulnerabilities (trivy"]},
    "grype": {"family": "scan", "stages": ["sca", "container_scan"], "cli": "grype", "docker_image": "anchore/grype:latest", "install": "brew install grype",
      "argv": {"sca": ["grype", "dir:$ROOT", "--fail-on", "high"], "container_scan": ["grype", "$IMAGE", "--fail-on", "high"]},
      "env": ["NVD_API_KEY"], "extract": {"count_regex": "(?i)(\\d+)\\s+(high|critical)", "line_regex": "NAME\\s+INSTALLED|High|Critical", "fail_when": "exit!=0", "next_step_hit": "Upgrade the packages Grype listed.", "next_step_clean": "No high or critical Grype finding."}, "aliases": ["grype"]},
    "gitleaks": {"family": "scan", "stages": ["secrets_scan", "scanners"], "cli": "gitleaks", "docker_image": "zricethezav/gitleaks:latest", "install": "brew install gitleaks",
      "argv": {"secrets_scan": ["gitleaks", "detect", "--no-git", "--redact", "--source", "$ROOT"]},
      "ci_action": "gitleaks/gitleaks-action@v2", "env": ["GITLEAKS_LICENSE"],
      "extract": {"count_regex": "(\\d+)\\s+leaks? found", "line_regex": "leaks? found|Finding:|RuleID:|File:", "fail_when": "count>0", "next_step_hit": "Remove the secret Gitleaks found, rotate it, and move it to a placeholder.", "next_step_clean": "No secret found by Gitleaks."},
      "aliases": ["gitleaks", "secrets (gitleaks)"]},
    "trufflehog": {"family": "scan", "stages": ["secrets_scan"], "cli": "trufflehog", "docker_image": "trufflesecurity/trufflehog:latest", "install": "brew install trufflehog",
      "argv": {"secrets_scan": ["trufflehog", "filesystem", "$ROOT", "--only-verified", "--fail"]},
      "env": [], "extract": {"count_regex": "Found (\\d+) verified", "line_regex": "Found|Detector|File:", "fail_when": "exit!=0", "next_step_hit": "Rotate and remove the verified secret TruffleHog found.", "next_step_clean": "No verified secret."}, "aliases": ["trufflehog"]},
    "checkov": {"family": "scan", "stages": ["iac_scan"], "cli": "checkov", "docker_image": "bridgecrew/checkov:latest", "install": "uvx --from checkov checkov --version",
      "argv": {"iac_scan": ["checkov", "-d", "$ROOT", "--quiet", "--compact"]},
      "env": [], "extract": {"count_regex": "Failed checks:\\s*(\\d+)", "line_regex": "Passed checks|Failed checks|Check:", "fail_when": "count>0", "next_step_hit": "Fix the failed Checkov checks in the IaC files named.", "next_step_clean": "No failed Checkov check."}, "aliases": ["checkov"]},
    "tfsec": {"family": "scan", "stages": ["iac_scan"], "cli": "tfsec", "docker_image": "aquasec/tfsec:latest", "install": "brew install tfsec",
      "argv": {"iac_scan": ["tfsec", "$ROOT", "--minimum-severity", "HIGH"]},
      "env": [], "extract": {"count_regex": "(\\d+) potential problem", "line_regex": "Result|problem|Severity", "fail_when": "count>0", "next_step_hit": "Fix the Terraform issues tfsec listed.", "next_step_clean": "No tfsec problem."}, "aliases": ["tfsec"]},
    "syft": {"family": "scan", "stages": ["sbom"], "cli": "syft", "docker_image": "anchore/syft:latest", "install": "brew install syft",
      "argv": {"sbom": ["syft", "dir:$ROOT", "-o", "cyclonedx-json=var/sbom.cdx.json"]},
      "env": [], "extract": {"count_regex": "Cataloged (\\d+) packages", "line_regex": "Cataloged|packages", "fail_when": "exit!=0", "next_step_hit": "SBOM generation failed; check the syft output.", "next_step_clean": "SBOM written to var/sbom.cdx.json."}, "aliases": ["syft", "sbom"]},
    "zap": {"family": "scan", "stages": ["dast_scan", "dast"], "cli": "zap.sh", "docker_image": "ghcr.io/zaproxy/zaproxy:stable", "install": "docker image only",
      "argv": {"dast_scan": ["docker", "run", "--rm", "-t", "ghcr.io/zaproxy/zaproxy:stable", "zap-baseline.py", "-t", "$APP_URL", "-I"]},
      "ci_action": "zaproxy/action-baseline@v0.15.0", "env": [],
      "extract": {"count_regex": "FAIL-NEW:\\s*(\\d+)", "line_regex": "WARN-NEW|FAIL-NEW|PASS:", "fail_when": "count>0", "next_step_hit": "Add the missing browser security headers ZAP reported, then run DAST again.", "next_step_clean": "ZAP baseline reported no new failures."},
      "aliases": ["zap", "owasp zap"]},
    "stackhawk": {"family": "scan", "stages": ["dast_scan", "dast"], "cli": "hawk", "docker_image": "stackhawk/hawkscan:latest", "install": "brew install stackhawk/cli/hawk",
      "argv": {"dast_scan": ["hawk", "scan", "stackhawk.yml"]},
      "ci_action": "stackhawk/hawkscan-action@v3.1.1", "env": ["HAWK_API_KEY", "HAWK_APP_ID", "APP_URL"],
      "extract": {"count_regex": "High:\\s*(\\d+)", "line_regex": "High:|Medium:|View on StackHawk|Risk:", "fail_when": "count>0", "next_step_hit": "Open the StackHawk scan link and fix the Medium or High findings.", "next_step_clean": "No Medium or High StackHawk finding."},
      "aliases": ["stackhawk", "hawkscan"]},
    "nuclei": {"family": "scan", "stages": ["dast_scan"], "cli": "nuclei", "docker_image": "projectdiscovery/nuclei:latest", "install": "brew install nuclei",
      "argv": {"dast_scan": ["nuclei", "-u", "$APP_URL", "-severity", "high,critical", "-silent"]},
      "env": [], "extract": {"count_regex": "", "line_regex": "\\[(high|critical)\\]", "fail_when": "exit!=0", "next_step_hit": "Fix the high or critical nuclei template matches.", "next_step_clean": "No nuclei high or critical match."}, "aliases": ["nuclei"]},
    "hadolint": {"family": "scan", "stages": ["dockerfile_lint"], "cli": "hadolint", "docker_image": "hadolint/hadolint:latest", "install": "brew install hadolint",
      "argv": {"dockerfile_lint": ["hadolint", "Dockerfile"]},
      "env": [], "extract": {"count_regex": "", "line_regex": "DL\\d{4}|SC\\d{4}", "fail_when": "exit!=0", "next_step_hit": "Fix the Dockerfile rules hadolint listed.", "next_step_clean": "Dockerfile passes hadolint."}, "aliases": ["hadolint"]},
    "actionlint": {"family": "scan", "stages": ["workflow_lint"], "cli": "actionlint", "docker_image": "rhysd/actionlint:latest", "install": "brew install actionlint",
      "argv": {"workflow_lint": ["actionlint", "-color", "never"]},
      "env": [], "extract": {"count_regex": "", "line_regex": "\\.github/workflows/", "fail_when": "exit!=0", "next_step_hit": "Fix the workflow errors actionlint listed.", "next_step_clean": "Workflows pass actionlint."}, "aliases": ["actionlint"]},
    "shellcheck": {"family": "scan", "stages": ["workflow_lint"], "cli": "shellcheck", "docker_image": "koalaman/shellcheck:stable", "install": "brew install shellcheck",
      "argv": {"workflow_lint": ["shellcheck", "ci/*.sh"]},
      "env": [], "extract": {"count_regex": "", "line_regex": "SC\\d{4}", "fail_when": "exit!=0", "next_step_hit": "Fix the shellcheck findings.", "next_step_clean": "Scripts pass shellcheck."}, "aliases": ["shellcheck"]},
    "pytest": {"family": "test", "stages": ["unit_test", "integration_test", "test"], "cli": "pytest", "docker_image": null, "install": "in requirements-dev.txt",
      "argv": {"unit_test": ["python", "-m", "pytest", "-q"], "integration_test": ["python", "-m", "pytest", "-q", "-m", "integration"]},
      "env": [], "extract": {"count_regex": "(\\d+)\\s+failed", "line_regex": "passed|failed|^FAILED", "fail_when": "count>0", "next_step_hit": "Fix the failing tests, then run the test stage again.", "next_step_clean": "No test change is required."}, "aliases": ["pytest"]},
    "k6": {"family": "test", "stages": ["perf_test"], "cli": "k6", "docker_image": "grafana/k6:latest", "install": "brew install k6",
      "argv": {"perf_test": ["k6", "run", "--vus", "5", "--duration", "20s", "ci/perf.js"]},
      "env": ["APP_URL"], "extract": {"count_regex": "✗\\s*(\\d+)", "line_regex": "http_req_duration|checks|✗|✓", "fail_when": "exit!=0", "next_step_hit": "Investigate the failed k6 thresholds.", "next_step_clean": "k6 thresholds passed."}, "aliases": ["k6"]},
    "schemathesis": {"family": "test", "stages": ["contract_test"], "cli": "schemathesis", "docker_image": "schemathesis/schemathesis:stable", "install": "uvx --from schemathesis schemathesis --version",
      "argv": {"contract_test": ["schemathesis", "run", "$APP_URL/openapi.json", "--checks", "all", "--max-examples", "20"]},
      "env": ["APP_URL"], "extract": {"count_regex": "(\\d+)\\s+failed", "line_regex": "passed|failed|FAILURES", "fail_when": "count>0", "next_step_hit": "Fix the API contract failures schemathesis found.", "next_step_clean": "API contract checks passed."}, "aliases": ["schemathesis"]},
    "cosign": {"family": "release", "stages": ["sign_artifact"], "cli": "cosign", "docker_image": "gcr.io/projectsigstore/cosign:latest", "install": "brew install cosign",
      "argv": {"sign_artifact": ["cosign", "sign-blob", "--key", "env://COSIGN_KEY", "dist/langgraph-support-app.tgz"]},
      "env": ["COSIGN_KEY", "COSIGN_PASSWORD"], "extract": {"count_regex": "", "line_regex": "signature|error", "fail_when": "exit!=0", "next_step_hit": "Check the cosign key and password placeholders.", "next_step_clean": "Artifact signed."}, "aliases": ["cosign"]}
  }
}
