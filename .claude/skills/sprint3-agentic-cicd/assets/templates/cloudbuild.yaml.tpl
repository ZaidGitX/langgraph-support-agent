# Generated by the orchestrator for stage "$STAGE" (family $FAMILY) on $GENERATED_AT.
# Google Cloud Build config, submitted with gcloud builds submit --config. No production step.
substitutions:
  _RUN_ID: "$RUN_ID"
  _TIER: "$TIER"
  _APP_NAME: "$APP_NAME"
  _REGION: "$REGION"

options:
  logging: CLOUD_LOGGING_ONLY

steps:
  - name: gcr.io/cloud-builders/gcloud
    id: refuse-production
    entrypoint: bash
    args:
      - -c
      - 'case "$${_TIER}" in production|prod) echo "No path past UAT."; exit 2;; esac'

  # --- ASTRA: steps ---
  # Write the steps for "$PURPOSE" here. Use python:$PYTHON_VERSION or
  # gcr.io/cloud-builders/docker images. Secrets come from availableSecrets by NAME only.
  - name: python:$PYTHON_VERSION-slim
    id: $STAGE
    entrypoint: bash
    args:
      - -c
      - 'echo "stage $STAGE placeholder"'

timeout: 1800s
