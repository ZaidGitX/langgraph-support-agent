# Generated by the orchestrator for stage "$STAGE" on $GENERATED_AT.
# Applied with `kubectl apply --dry-run=client -f` in plan mode and `kubectl apply -f` in
# apply mode. Namespace comes from K8S_NAMESPACE. Never a production namespace.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: $APP_NAME
  labels:
    app: $APP_NAME
    tier: $TIER
    orchestrator-run: "$RUN_ID"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: $APP_NAME
  template:
    metadata:
      labels:
        app: $APP_NAME
        tier: $TIER
    spec:
      containers:
        - name: api
          image: $IMAGE
          ports:
            - containerPort: $PORT
          env:
            - name: TIER
              value: "$TIER"
            - name: ORCHESTRATOR_AUTOSTART
              value: "0"
            # Secrets are mounted from a Secret object by NAME; never inline values.
$ENV_LINES
          readinessProbe:
            httpGet:
              path: /status
              port: $PORT
            initialDelaySeconds: 10
          # --- ASTRA: steps ---
          # Adjust resources or add sidecars for "$PURPOSE".
---
apiVersion: v1
kind: Service
metadata:
  name: $APP_NAME
spec:
  selector:
    app: $APP_NAME
  ports:
    - port: 80
      targetPort: $PORT
