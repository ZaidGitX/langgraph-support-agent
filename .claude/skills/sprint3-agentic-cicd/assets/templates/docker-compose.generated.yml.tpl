# Generated by the orchestrator for stage "$STAGE" on $GENERATED_AT.
# Tier: $TIER. Use with `docker compose -f docker-compose.generated.yml up -d` locally or
# over ssh (ssh_compose provider). Every value below is a placeholder read from the
# environment by NAME; nothing here is a secret.
services:
  $APP_NAME:
    image: $IMAGE
    build:
      context: .
      dockerfile: Dockerfile.generated
    ports:
      - "$PORT:$PORT"
    environment:
      TIER: "$TIER"
      APP_NAME: "$APP_NAME"
      ORCHESTRATOR_AUTOSTART: "0"
$ENV_LINES
    volumes:
      - $APP_NAME-var:/app/var
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:$PORT/status')"]
      interval: 30s
      timeout: 10s
      retries: 3
    # --- ASTRA: steps ---
    # Add sidecars (database, scanner) for "$PURPOSE" below if the stage needs them.

volumes:
  $APP_NAME-var:
