# Generated by the orchestrator for stage "$STAGE" (family $FAMILY) on $GENERATED_AT.
# Azure Pipelines YAML, started with az pipelines run. No production stage.
trigger: none
pr: none

parameters:
  - name: runId
    type: string
    default: "$RUN_ID"
  - name: tier
    type: string
    default: "$TIER"
    values: [local, dev, staging, uat]

variables:
  APP_NAME: "$APP_NAME"
  PLATFORM: "azure"
  TIER: $${{ parameters.tier }}
  RUN_ID: $${{ parameters.runId }}

pool:
  vmImage: ubuntu-latest

stages:
  - stage: $STAGE
    jobs:
      - job: $STAGE
        timeoutInMinutes: 30
        steps:
          - task: UsePythonVersion@0
            inputs:
              versionSpec: "$PYTHON_VERSION"
          - bash: |
              case "$$(TIER)" in production|prod) echo "No path past UAT."; exit 2;; esac
            displayName: Refuse production
          # --- ASTRA: steps ---
          # Write the steps for "$PURPOSE" here. Secrets come from a variable group by NAME
          # ($$(NAME)); never a literal value. Print a one-line summary at the end.
          - bash: echo "stage $STAGE placeholder"
            displayName: $STAGE
