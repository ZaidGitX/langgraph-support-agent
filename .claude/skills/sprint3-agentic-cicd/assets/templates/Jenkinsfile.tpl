// Generated by the orchestrator for stage "$STAGE" (family $FAMILY) on $GENERATED_AT.
// Triggered by the orchestrator through buildWithParameters. No production stage.
pipeline {
  agent any
  options { timeout(time: 30, unit: 'MINUTES') }
  parameters {
    string(name: 'RUN_ID', defaultValue: '', description: 'Orchestrator run id')
    string(name: 'TIER', defaultValue: '$TIER', description: 'local, dev, staging, or uat. Production is not a choice.')
  }
  environment {
    APP_NAME = '$APP_NAME'
    PLATFORM = '$PLATFORM'
$ENV_LINES
  }
  stages {
    stage('Refuse production') {
      steps {
        sh 'case "$$TIER" in production|prod) echo "No path past UAT."; exit 2;; esac'
      }
    }
    stage('$STAGE') {
      steps {
        // --- ASTRA: steps ---
        // Write the sh steps for "$PURPOSE" here. Use credentials() bindings or
        // $$NAME placeholders; never a literal value. Print a one-line summary at the end.
        sh 'echo "stage $STAGE placeholder"'
      }
    }
  }
  post {
    always { echo "stage $STAGE finished for run $${params.RUN_ID}" }
  }
}
